PORT=3000
# Interface de rede. Em servidor gerenciado precisa ser 0.0.0.0 (que já é o padrão).
HOST=0.0.0.0

DATABASE_URL=postgres://tcc:tcc@localhost:5433/tcc
# Conexão criptografada com o banco. Vazio = decide sozinho (liga fora do
# localhost). Use "no-verify" se o provedor usar certificado próprio.
DATABASE_SSL=

JWT_SECRET=troque-isto-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Endereços autorizados a chamar a API, separados por vírgula.
# Em produção troque o "*" pelo endereço real do painel.
CORS_ORIGIN=*

# Login com Google. Use o MESMO Client ID configurado no VITE_GOOGLE_CLIENT_ID
# da web — a API confere se o token foi emitido para este aplicativo.
# A credencial precisa ser do tipo "Aplicativo da Web" (ver docs/LOGIN_GOOGLE.md).
# Deixe em branco para desativar o login social.
GOOGLE_CLIENT_ID=

# URL do painel web (link no e-mail de redefinir senha)
WEB_APP_URL=http://localhost:5173

# E-mail via Gmail (senha de app, NÃO a senha normal da conta):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=isacbuzelli3@gmail.com
SMTP_PASS=
SMTP_FROM=NutriCare <isacbuzelli3@gmail.com>

# ---------------------------------------------------------------------------
# Logs em arquivo
# ---------------------------------------------------------------------------
# Nível mínimo: DEBUG | INFO | WARN | ERROR | FATAL (padrão INFO).
# DEBUG mostra também as sondas de /health e o detalhe dos erros.
LOG_LEVEL=
# Grava logs/app.log e logs/error.log (padrão true). A pasta está no .gitignore.
LOG_TO_FILE=true
LOG_DIR=logs
# Tamanho máximo de cada arquivo em MB; ao estourar vira .log.1 (padrão 5).
LOG_MAX_SIZE_MB=5

# Credenciais usadas SÓ pelo `npm run health` para testar as rotas autenticadas.
# Sem elas o diagnóstico marca esses testes como SKIPPED. Nunca são impressas.
DIAG_EMAIL=
DIAG_SENHA=
DIAG_ADMIN_EMAIL=
DIAG_ADMIN_SENHA=

# ---------------------------------------------------------------------------
# Central de monitoramento (projeto separado: ../monitoramento-nutricare)
# ---------------------------------------------------------------------------
# Desligado por padrão. Com `false` nenhuma requisição sai daqui e o NutriCare
# funciona exatamente como antes.
MONITORING_ENABLED=false
MONITORING_API_URL=http://localhost:4000
# Chave de SERVIÇO da central (MONITORING_SERVICE_KEY lá). Nunca commitar.
MONITORING_API_KEY=
# Timeout curto de propósito: a API nunca espera a central.
MONITORING_TIMEOUT_MS=2000
# Como esta API se identifica na central.
MONITORING_APP=nutricare
MONITORING_SERVICE=backend
# Vazio herda NODE_ENV. Valores aceitos: development | test | staging | production
MONITORING_ENV=
# Intervalo do "estou online" (padrão 60000).
MONITORING_HEARTBEAT_MS=60000
# Versão da aplicação, enviada junto de cada evento.
APP_VERSION=
