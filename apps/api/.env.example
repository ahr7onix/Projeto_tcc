PORT=3000
# Interface de rede. Em servidor gerenciado precisa ser 0.0.0.0 (que já é o padrão).
HOST=0.0.0.0

DATABASE_URL=postgres://tcc:tcc@localhost:5433/tcc
# Conexão criptografada com o banco. Vazio = decide sozinho (liga fora do
# localhost). Use "no-verify" se o provedor usar certificado próprio.
DATABASE_SSL=

JWT_SECRET=troque-isto-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Endereços autorizados a chamar a API, separados por vírgula.
# Em produção troque o "*" pelo endereço real do painel.
CORS_ORIGIN=*

# Login com Google. Use o MESMO Client ID configurado no VITE_GOOGLE_CLIENT_ID
# da web — a API confere se o token foi emitido para este aplicativo.
# A credencial precisa ser do tipo "Aplicativo da Web" (ver docs/LOGIN_GOOGLE.md).
# Deixe em branco para desativar o login social.
GOOGLE_CLIENT_ID=
