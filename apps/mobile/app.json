{
  "expo": {
    "name": "NutriCare",
    "slug": "projeto-tcc-mobile",
    "scheme": "projetotcc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projetotcc.mobile"
    },
    "android": {
      "package": "com.projetotcc.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/alarme.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e3fc9593-b908-4c3f-94d0-5e4d365cac79"
      }
    },
    "owner": "natanzinho23"
  }
}
