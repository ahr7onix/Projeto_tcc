# URL da API NutriCare
VITE_API_URL=http://localhost:3000

# Google OAuth — obtenha em https://console.cloud.google.com
# 1. Crie um projeto > APIs e Serviços > Credenciais
# 2. Criar credencial > ID do cliente OAuth > Aplicativo da Web
# 3. Origens permitidas: http://localhost:5173
# 4. Cole o "ID do cliente" abaixo:
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Central de monitoramento (projeto separado: ../../monitoramento-nutricare)
# ---------------------------------------------------------------------------
# Desligado por padrão.
VITE_MONITORING_ENABLED=false
VITE_MONITORING_API_URL=http://localhost:4000
# Chave PÚBLICA da central (MONITORING_PUBLIC_KEY lá). Ela vai embutida no
# bundle e por isso é pública na prática: a central só aceita dela eventos de
# origem "frontend", com limite de taxa menor e sem acesso ao painel.
# NUNCA use aqui a MONITORING_SERVICE_KEY.
VITE_MONITORING_PUBLIC_KEY=
VITE_MONITORING_APP=nutricare
VITE_APP_VERSION=
