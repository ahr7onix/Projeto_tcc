{
  "expo": {
    "name": "NutriCare",
    "slug": "projeto-tcc-mobile",
    "scheme": "projetotcc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projetotcc.mobile"
    },
    "android": {
      "package": "com.projetotcc.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005EB8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/alarme.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#005EB8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e3fc9593-b908-4c3f-94d0-5e4d365cac79"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e3fc9593-b908-4c3f-94d0-5e4d365cac79"
      }
    },
    "owner": "natanzinho23"
  }
}
