# URL da API NutriCare
VITE_API_URL=http://localhost:3000

# Google OAuth — obtenha em https://console.cloud.google.com
# 1. Crie um projeto > APIs e Serviços > Credenciais
# 2. Criar credencial > ID do cliente OAuth > Aplicativo da Web
# 3. Origens permitidas: http://localhost:5173
# 4. Cole o "ID do cliente" abaixo:
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
